# From Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Temporary shared staff access code (until Google sign-in is on).
# Everyone who enters the code signs in as this one shared Supabase user.
STAFF_ACCESS_CODE=
STAFF_SHARED_EMAIL=
STAFF_SHARED_PASSWORD=

# Set to "on" once Google sign-in is configured in Supabase.
NEXT_PUBLIC_GOOGLE_SIGNIN=

# Other Alpha NYC apps the hub links to
NEXT_PUBLIC_ATTENDANCE_URL=
NEXT_PUBLIC_OFF_CAMPUS_URL=

# Parent Hub (/parents) and request notifications. Set in Vercel, never commit values.
SUPABASE_SERVICE_ROLE_KEY=
PARENT_HUB_SECRET=
RESEND_API_KEY=
PARENT_HUB_EMAIL_FROM=
SLACK_WEBHOOK_URL=
