# From Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Temporary shared staff access code (until Google sign-in is on).
# Everyone who enters the code signs in as this one shared Supabase user.
STAFF_ACCESS_CODE=
STAFF_SHARED_EMAIL=
STAFF_SHARED_PASSWORD=

# Set to "on" once Google sign-in is configured in Supabase.
NEXT_PUBLIC_GOOGLE_SIGNIN=
